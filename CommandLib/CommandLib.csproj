<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- msbuild.exe/Visual Studio builds the Windows app only; the dotnet CLI also builds net10.0 for Linux -->
		<TargetFrameworks Condition="'$(MSBuildRuntimeType)' == 'Full'">net481</TargetFrameworks>
		<TargetFrameworks Condition="'$(MSBuildRuntimeType)' != 'Full'">net481;net10.0</TargetFrameworks>
		<Title>CommandLib</Title>
		<Description>XCP-ng Center library</Description>
	</PropertyGroup>
</Project>