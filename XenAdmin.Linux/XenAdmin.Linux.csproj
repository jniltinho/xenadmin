<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<AssemblyName>xcp-ng-center</AssemblyName>
		<RootNamespace>XenAdmin.Linux</RootNamespace>
		<Title>XCP-ng Center for Linux</Title>
		<Description>XCP-ng Center desktop app for Linux</Description>
		<ApplicationIcon>..\branding-xcp-ng\Images\AppIcon.ico</ApplicationIcon>
		<!-- the app itself must not call Windows-only APIs -->
		<WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.2" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\XenModel\XenModel.csproj" />
	</ItemGroup>
	<ItemGroup>
		<AvaloniaResource Include="..\branding-xcp-ng\Images\AppIcon.ico" Link="Assets\AppIcon.ico" />
	</ItemGroup>
</Project>
